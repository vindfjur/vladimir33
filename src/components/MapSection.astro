---
// Категории — единый источник для легенды-фильтра и стиля точек на карте.
const categories = [
  { id: 'touristic', label: 'Достопримечательности', emoji: '🗺️', color: '#1E90FF' },
  { id: 'museum', label: 'Музеи', emoji: '🏛️', color: '#8a1c3b' },
  { id: 'gastronomic', label: 'Где поесть', emoji: '🍴', color: '#e7553b' },
  { id: 'hotel', label: 'Где остановиться', emoji: '🏨', color: '#c79a1e' },
  { id: 'cultural', label: 'Культура', emoji: '🎭', color: '#8B4513' },
  { id: 'souvenir', label: 'Сувениры', emoji: '🎁', color: '#FF8C00' },
  { id: 'natural', label: 'Природа', emoji: '🌲', color: '#2e8b3d' },
];
---

<section id="map" class="section map-section">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">Регион на ладони</p>
      <h2>Интерактивная карта</h2>
      <p class="section__lead">
        Достопримечательности, музеи, кафе, гостиницы и природные места
        Владимирской области — на одной карте. Выбирайте категории и стройте
        своё путешествие.
      </p>
    </div>
  </div>

  <div class="container map-layout">
    <aside class="map-filters" aria-label="Категории на карте">
      {
        categories.map((c) => (
          <label class="filter" style={`--dot:${c.color}`}>
            <input type="checkbox" value={c.id} checked data-cat-toggle />
            <span class="filter__dot" />
            <span class="filter__emoji">{c.emoji}</span>
            <span class="filter__label">{c.label}</span>
            <span class="filter__count" data-count={c.id}>—</span>
          </label>
        ))
      }
      <p class="map-attrib">Данные © OpenStreetMap (ODbL) · фон © OpenFreeMap</p>
    </aside>

    <div class="map-wrap">
      <div id="vmap" data-categories={JSON.stringify(categories)}></div>
    </div>
  </div>
</section>

<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';

  const el = document.getElementById('vmap');
  if (el) {
    type Cat = { id: string; label: string; emoji: string; color: string };
    const categories: Cat[] = JSON.parse(el.dataset.categories || '[]');
    const active = new Set(categories.map((c) => c.id));

    const map = new maplibregl.Map({
      container: 'vmap',
      style: 'https://tiles.openfreemap.org/styles/positron',
      center: [40.7, 56.2],
      zoom: 7,
      attributionControl: false,
    });
    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
    map.addControl(new maplibregl.AttributionControl({ compact: true }), 'bottom-right');

    const colorMatch: any = ['match', ['get', 'cat']];
    categories.forEach((c) => colorMatch.push(c.id, c.color));
    colorMatch.push('#888');

    const bbox = (geo: any): [number, number, number, number] => {
      let minX = 180, minY = 90, maxX = -180, maxY = -90;
      const walk = (a: any) => {
        if (typeof a[0] === 'number') {
          minX = Math.min(minX, a[0]); maxX = Math.max(maxX, a[0]);
          minY = Math.min(minY, a[1]); maxY = Math.max(maxY, a[1]);
        } else a.forEach(walk);
      };
      geo.features.forEach((f: any) => walk(f.geometry.coordinates));
      return [minX, minY, maxX, maxY];
    };

    map.on('load', async () => {
      const [oblast, poi] = await Promise.all([
        fetch('/data/vladimir-oblast.geojson').then((r) => r.json()),
        fetch('/data/poi.geojson').then((r) => r.json()),
      ]);

      map.addSource('oblast', { type: 'geojson', data: oblast });
      map.addLayer({
        id: 'oblast-fill', type: 'fill', source: 'oblast',
        paint: { 'fill-color': '#c08a2d', 'fill-opacity': 0.05 },
      });
      map.addLayer({
        id: 'oblast-line', type: 'line', source: 'oblast',
        paint: { 'line-color': '#9a6c1e', 'line-width': 2, 'line-opacity': 0.7 },
      });

      map.addSource('poi', { type: 'geojson', data: poi });
      map.addLayer({
        id: 'poi', type: 'circle', source: 'poi',
        paint: {
          'circle-radius': ['interpolate', ['linear'], ['zoom'], 7, 3.2, 11, 6, 14, 8],
          'circle-color': colorMatch,
          'circle-stroke-color': '#fff',
          'circle-stroke-width': 1.2,
          'circle-opacity': 0.9,
        },
      });

      const [minX, minY, maxX, maxY] = bbox(oblast);
      map.fitBounds([[minX, minY], [maxX, maxY]], { padding: 24, duration: 0 });
      map.setMaxBounds([[minX - 0.6, minY - 0.4], [maxX + 0.6, maxY + 0.4]]);
      map.setMinZoom(map.getZoom() - 0.4);

      const counts: Record<string, number> = {};
      poi.features.forEach((f: any) => (counts[f.properties.cat] = (counts[f.properties.cat] || 0) + 1));
      document.querySelectorAll<HTMLElement>('[data-count]').forEach((node) => {
        node.textContent = String(counts[node.dataset.count!] || 0);
      });

      const popup = new maplibregl.Popup({ closeButton: true, maxWidth: '260px', offset: 10 });
      map.on('click', 'poi', (e) => {
        const p = e.features?.[0]?.properties as any;
        if (!p) return;
        const link = p.website
          ? `<a href="${p.website}" target="_blank" rel="noopener">Подробнее →</a>`
          : '';
        popup
          .setLngLat((e.features![0].geometry as any).coordinates)
          .setHTML(`<strong>${p.name}</strong><span class="pk">${p.kind}</span>${link}`)
          .addTo(map);
      });
      map.on('mouseenter', 'poi', () => (map.getCanvas().style.cursor = 'pointer'));
      map.on('mouseleave', 'poi', () => (map.getCanvas().style.cursor = ''));

      const applyFilter = () =>
        map.setFilter('poi', ['in', ['get', 'cat'], ['literal', [...active]]]);
      document.querySelectorAll<HTMLInputElement>('[data-cat-toggle]').forEach((cb) => {
        cb.addEventListener('change', () => {
          cb.checked ? active.add(cb.value) : active.delete(cb.value);
          applyFilter();
        });
      });
      applyFilter();
    });
  }
</script>

<style>
  .map-layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 1.4rem;
    align-items: start;
  }
  .map-filters {
    display: grid;
    gap: 0.4rem;
    padding: 1rem;
    background: var(--c-white);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-s);
    position: sticky;
    top: calc(var(--header-h) + 1rem);
  }
  .filter {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.55rem;
    border-radius: var(--radius-s);
    cursor: pointer;
    transition: background 0.2s;
  }
  .filter:hover { background: var(--c-parchment-2); }
  .filter input { accent-color: var(--dot); width: 16px; height: 16px; margin: 0; flex: none; }
  .filter__dot { width: 11px; height: 11px; border-radius: 50%; background: var(--dot); flex: none; }
  .filter__emoji { font-size: 1rem; flex: none; }
  .filter__label {
    flex: 1;
    min-width: 0;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--c-ink);
    line-height: 1.2;
  }
  .filter__count {
    flex: none;
    margin-left: auto;
    padding-left: 0.4rem;
    font-size: var(--step--1);
    color: var(--c-ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .filter input:not(:checked) ~ .filter__label,
  .filter input:not(:checked) ~ .filter__emoji { opacity: 0.4; }
  .map-attrib { margin-top: 0.5rem; font-size: 0.72rem; color: var(--c-ink-soft); line-height: 1.4; }

  .map-wrap {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    border: 1px solid var(--c-line);
  }
  #vmap { height: min(72vh, 640px); width: 100%; background: #eaeaea; }

  :global(.maplibregl-popup-content) {
    font-family: var(--font-body);
    border-radius: var(--radius-s);
    padding: 0.9rem 1rem;
    box-shadow: var(--shadow);
  }
  :global(.maplibregl-popup-content strong) {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--c-ink);
  }
  :global(.maplibregl-popup-content .pk) {
    display: block;
    font-size: 0.8rem;
    color: var(--c-ink-soft);
    margin: 0.15rem 0 0.4rem;
  }

  @media (max-width: 820px) {
    .map-layout { grid-template-columns: 1fr; }
    .map-filters { position: static; }
  }
</style>
