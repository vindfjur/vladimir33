---
import data from '../data/gallery.json';
const items = data.items;
---

<section id="gallery" class="section gallery-section">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">Взгляд</p>
      <h2>Фотогалерея</h2>
      <p class="section__lead">
        Личные фотографии автора сайта — яркие и вдохновляющие уголки города и
        области, снятые во время прогулок и поездок.
      </p>
    </div>

    <div class="gallery">
      {
        items.map((g, i) => (
          <button
            class="gallery__item"
            type="button"
            data-gallery-item={i}
            data-title={g.title}
            data-description={g.description}
          >
            <img src={g.image} alt={g.title} loading="lazy" />
            <span class="gallery__caption">{g.title}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="lightbox" data-lightbox hidden>
    <button class="lightbox__close" data-lb-close aria-label="Закрыть">×</button>
    <figure class="lightbox__figure">
      <img data-lb-img src="" alt="" />
      <figcaption>
        <strong data-lb-title></strong>
        <span data-lb-desc></span>
      </figcaption>
    </figure>
    <p class="lightbox__hint">← листайте · смахните вверх, чтобы закрыть</p>
  </div>
</section>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-gallery-item]'));
  const lb = document.querySelector<HTMLElement>('[data-lightbox]');
  if (lb && items.length) {
    const img = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const elTitle = lb.querySelector<HTMLElement>('[data-lb-title]')!;
    const elDesc = lb.querySelector<HTMLElement>('[data-lb-desc]')!;
    const data = items.map((el) => ({
      src: el.querySelector('img')!.src,
      title: el.dataset.title ?? '',
      desc: el.dataset.description ?? '',
    }));
    let i = 0;

    const render = () => {
      const d = data[i];
      img.src = d.src;
      img.alt = d.title;
      elTitle.textContent = d.title;
      elDesc.textContent = d.desc;
    };
    const open = (n: number) => {
      i = n;
      render();
      lb.hidden = false;
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lb.hidden = true;
      document.body.style.overflow = '';
    };
    const go = (step: number) => {
      i = (i + step + data.length) % data.length;
      render();
    };

    items.forEach((el, n) => el.addEventListener('click', () => open(n)));
    lb.querySelector('[data-lb-close]')!.addEventListener('click', close);
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });

    let sx: number | null = null;
    let sy: number | null = null;
    lb.addEventListener('touchstart', (e) => {
      sx = e.changedTouches[0].screenX;
      sy = e.changedTouches[0].screenY;
    }, { passive: true });
    lb.addEventListener('touchend', (e) => {
      if (sx === null || sy === null) return;
      const dx = e.changedTouches[0].screenX - sx;
      const dy = e.changedTouches[0].screenY - sy;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.5) go(dx < 0 ? 1 : -1);
      else if (dy < -90 && Math.abs(dy) > Math.abs(dx) * 1.5) close();
      sx = sy = null;
    }, { passive: true });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') go(-1);
      else if (e.key === 'ArrowRight') go(1);
    });
  }
</script>

<style>
  .gallery {
    columns: 4 240px;
    column-gap: 1rem;
  }
  .gallery__item {
    position: relative;
    display: block;
    width: 100%;
    margin: 0 0 1rem;
    padding: 0;
    border: none;
    border-radius: var(--radius-s);
    overflow: hidden;
    cursor: pointer;
    background: none;
    break-inside: avoid;
    box-shadow: var(--shadow-s);
  }
  .gallery__item img { width: 100%; display: block; transition: transform 0.5s ease; }
  .gallery__item:hover img { transform: scale(1.05); }
  .gallery__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.4rem 0.9rem 0.7rem;
    color: var(--c-white);
    font-weight: 700;
    font-size: var(--step--1);
    text-align: left;
    background: linear-gradient(180deg, transparent, rgba(20, 14, 8, 0.8));
    opacity: 0;
    transition: opacity 0.3s;
  }
  .gallery__item:hover .gallery__caption { opacity: 1; }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-content: center;
    gap: 0.9rem;
    padding: clamp(1rem, 4vw, 3rem);
    background: rgba(15, 10, 6, 0.92);
    backdrop-filter: blur(4px);
  }
  .lightbox__hint {
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--c-parchment) 55%, transparent);
    letter-spacing: 0.02em;
  }
  .lightbox[hidden] { display: none; }
  .lightbox__figure { margin: 0; text-align: center; display: grid; gap: 0.8rem; justify-items: center; }
  .lightbox__figure img {
    max-width: min(90vw, 1100px);
    max-height: 78vh;
    border-radius: var(--radius-s);
    box-shadow: var(--shadow);
  }
  .lightbox__figure figcaption { color: var(--c-parchment); display: grid; gap: 0.25rem; max-width: 60ch; }
  .lightbox__figure strong { font-family: var(--font-display); font-size: var(--step-1); color: var(--c-white); }
  .lightbox__figure span { color: color-mix(in srgb, var(--c-parchment) 75%, transparent); font-family: var(--font-serif); }
  .lightbox__close {
    position: absolute;
    top: 1rem;
    right: 1.2rem;
    width: 44px;
    height: 44px;
    font-size: 1.8rem;
  }
  .lightbox__close {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: var(--c-white);
    border-radius: 50%;
    cursor: pointer;
    line-height: 1;
    transition: background 0.2s;
    touch-action: manipulation;
  }
  .lightbox__close:hover { background: rgba(255, 255, 255, 0.25); }
  .gallery__item { touch-action: manipulation; }

  @media (max-width: 640px) {
    .gallery {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
      columns: initial;
    }
    .gallery__item { margin: 0; }
    .lightbox { padding: 1rem; }
    .lightbox__close { top: 0.8rem; right: 0.8rem; width: 38px; height: 38px; font-size: 1.5rem; }
  }
</style>
