---
import { getCollection } from 'astro:content';
import { site } from '../../site';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((a) => ({ params: { slug: a.data.slug }, props: { article: a.data } }));
}
const { article } = Astro.props;

// Генератор SVG-орнаментов для полноэкранных страниц статей.
const rosette = (r = 17, core = 6) =>
  Array.from({ length: 8 }, (_, k) => `<ellipse cx="0" cy="${-r}" rx="6" ry="${r * 0.85}" transform="rotate(${k * 45})" class="pa"/>`).join('') + `<circle r="${core}" class="pb"/>`;
const star8 = (r = 13) =>
  Array.from({ length: 8 }, (_, k) => `<path d="M0 0L3.5 ${-r / 2}L0 ${-r}L-3.5 ${-r / 2}Z" transform="rotate(${k * 45})" class="pb"/>`).join('') + `<circle r="2.6" class="pa"/>`;
const tree = () =>
  `<rect x="-2" y="6" width="4" height="40" class="pa"/>` +
  [0, 13, 26].map((dy) => `<path d="M-22 ${20 + dy}L0 ${4 + dy}L22 ${20 + dy}" class="sa" stroke-width="3" stroke-linejoin="round"/>`).join('') +
  `<circle cy="-2" r="4" class="pb"/>`;
const leaf = (x: number, y: number, rot: number) =>
  `<path d="M0 -11C7 -4 7 4 0 11C-7 4 -7 -4 0 -11Z" transform="translate(${x} ${y}) rotate(${rot})" class="pb"/>`;
const sun = (r = 11) =>
  Array.from({ length: 12 }, (_, k) => `<rect x="-1.4" y="${-r - 9}" width="2.8" height="8" transform="rotate(${k * 30})" class="pa"/>`).join('') + `<circle r="${r}" class="pb"/>`;
const fir = () =>
  `<path d="M0 -34L14 -8L-14 -8Z" class="pa"/><path d="M0 -20L20 14L-20 14Z" class="pa"/><rect x="-3" y="14" width="6" height="12" class="pb"/>`;
const krin = () =>
  `<path d="M0 16C-9 2 -9 -14 0 -20C9 -14 9 2 0 16Z" class="pa"/>` +
  `<path d="M0 4C-14 1 -17 -10 -12 -17" class="sb" stroke-width="3"/>` +
  `<path d="M0 4C14 1 17 -10 12 -17" class="sb" stroke-width="3"/>`;

const gladFlower = () =>
  Array.from({ length: 12 }, (_, k) => `<path d="M0 -22L6 -50L-6 -50Z" transform="rotate(${k * 30})" class="pa"/>`).join('') +
  Array.from({ length: 12 }, (_, k) => `<path d="M0 -10L4.5 -28L-4.5 -28Z" transform="rotate(${k * 30 + 15})" class="pb"/>`).join('') +
  `<circle r="13" class="pb"/><path d="M-9 0H9M0 -9V9M-6.5 -6.5L6.5 6.5M-6.5 6.5L6.5 -6.5" class="sa" stroke-width="1.6"/>`;
const pava = () =>
  Array.from({ length: 5 }, (_, k) => `<ellipse cx="0" cy="-13" rx="3.4" ry="13" transform="translate(-13 0) rotate(${-44 + k * 22})" class="pb"/>`).join('') +
  `<ellipse cx="2" cy="-2" rx="12" ry="8.5" transform="rotate(-12)" class="pa"/>` +
  `<path d="M11 -6Q19 -10 16 -21" class="sa" stroke-width="3"/>` +
  `<circle cx="16" cy="-23" r="3.6" class="pa"/><path d="M19 -23l5 1.5l-5 2Z" class="pb"/>`;
const berry = (x: number, y: number) =>
  `<path d="M0 -7C6 -7 8 -1 0 9C-8 -1 -6 -7 0 -7Z" transform="translate(${x} ${y})" class="pa"/>` +
  `<circle cx="${x - 2}" cy="${y - 1}" r="0.9" class="pb"/><circle cx="${x + 2}" cy="${y + 1}" r="0.9" class="pb"/><circle cx="${x}" cy="${y + 4}" r="0.9" class="pb"/>`;

const patterns: { w: number; h: number; body: string }[] = [
  {
    w: 120, h: 120,
    body: `<path d="M0 0L120 120M120 0L0 120" class="sb" stroke-width="2"/>
      <g transform="translate(60 60)">${rosette()}</g>
      <circle cx="0" cy="0" r="6" class="pb"/><circle cx="120" cy="0" r="6" class="pb"/><circle cx="0" cy="120" r="6" class="pb"/><circle cx="120" cy="120" r="6" class="pb"/>
      <g transform="translate(60 0)"><path d="M0 -7L7 0L0 7L-7 0Z" class="pa"/></g><g transform="translate(60 120)"><path d="M0 -7L7 0L0 7L-7 0Z" class="pa"/></g>
      <g transform="translate(0 60)"><path d="M0 -7L7 0L0 7L-7 0Z" class="pa"/></g><g transform="translate(120 60)"><path d="M0 -7L7 0L0 7L-7 0Z" class="pa"/></g>`,
  },
  {
    w: 160, h: 120,
    body: `<path d="M0 60Q40 20 80 60T160 60" class="sa" stroke-width="3"/>
      <g transform="translate(80 60)">${rosette(15, 5)}</g>
      ${leaf(40, 38, -35)}${leaf(120, 82, 145)}${leaf(20, 78, 35)}${leaf(140, 38, -145)}
      <circle cx="0" cy="60" r="5" class="pb"/><circle cx="160" cy="60" r="5" class="pb"/>`,
  },
  {
    w: 84, h: 84,
    body: `<path d="M42 0L84 42L42 84L0 42Z" class="sb" stroke-width="2"/>
      <path d="M42 26L58 42L42 58L26 42Z" class="pa"/><path d="M42 36v12M36 42h12" class="sb" stroke-width="3"/>
      <circle cx="0" cy="0" r="5" class="pa"/><circle cx="84" cy="0" r="5" class="pa"/><circle cx="0" cy="84" r="5" class="pa"/><circle cx="84" cy="84" r="5" class="pa"/>`,
  },
  {
    w: 130, h: 150,
    body: `<g transform="translate(65 80)">${tree()}</g>
      <g transform="translate(0 0)">${star8()}</g><g transform="translate(130 0)">${star8()}</g><g transform="translate(0 150)">${star8()}</g><g transform="translate(130 150)">${star8()}</g>
      <g transform="translate(65 0)">${star8(9)}</g><g transform="translate(65 150)">${star8(9)}</g>`,
  },
  {
    w: 160, h: 110,
    body: `<path d="M0 62Q40 36 80 62T160 62" class="sa" stroke-width="3"/>
      <g transform="translate(80 28)">${sun()}</g>
      <circle cx="40" cy="90" r="3.5" class="pb"/><circle cx="120" cy="90" r="3.5" class="pb"/>
      <circle cx="0" cy="62" r="4" class="pb"/><circle cx="160" cy="62" r="4" class="pb"/>`,
  },
  {
    w: 96, h: 100,
    body: `<path d="M0 96H96" class="sb" stroke-width="2"/>
      <g transform="translate(48 70)">${fir()}</g>
      <g transform="translate(16 30)">${star8(7)}</g><g transform="translate(80 34)">${star8(7)}</g>`,
  },
  {
    w: 100, h: 100,
    body: `<path d="M0 0L100 100M100 0L0 100" class="sb" stroke-width="1.5"/><path d="M50 0L100 50L50 100L0 50Z" class="sb" stroke-width="1.5"/>
      <g transform="translate(50 50)">${star8(17)}</g>
      <circle cx="0" cy="0" r="5" class="pa"/><circle cx="100" cy="0" r="5" class="pa"/><circle cx="0" cy="100" r="5" class="pa"/><circle cx="100" cy="100" r="5" class="pa"/>`,
  },
  {
    w: 120, h: 120,
    body: `<path d="M60 0V120M0 60H120" class="sb" stroke-width="2.5"/>
      <g transform="translate(60 56)">${krin()}</g>
      <circle cx="30" cy="30" r="4" class="pa"/><circle cx="90" cy="30" r="4" class="pa"/><circle cx="30" cy="90" r="4" class="pa"/><circle cx="90" cy="90" r="4" class="pa"/>`,
  },
  {
    w: 90, h: 90,
    body: `<path d="M45 0L90 45L45 90L0 45Z" class="sb" stroke-width="2"/>
      <path d="M45 18L72 45L45 72L18 45Z" class="pa"/><path d="M45 34L56 45L45 56L34 45Z" class="pb"/>
      <circle cx="0" cy="0" r="4" class="pa"/><circle cx="90" cy="0" r="4" class="pa"/><circle cx="0" cy="90" r="4" class="pa"/><circle cx="90" cy="90" r="4" class="pa"/>`,
  },
  {
    w: 132, h: 132,
    body: `<g transform="translate(66 66)">${gladFlower()}</g>
      ${leaf(24, 24, -45)}${leaf(108, 24, 45)}${leaf(24, 108, -135)}${leaf(108, 108, 135)}
      <g transform="translate(66 0)">${berry(0, 6)}</g><g transform="translate(66 132)">${berry(0, -10)}</g>
      <g transform="translate(0 66)">${berry(6, 0)}</g><g transform="translate(132 66)">${berry(-6, 0)}</g>`,
  },
  {
    w: 170, h: 124,
    body: `<g transform="translate(50 76)">${pava()}</g>
      <g transform="translate(120 76) scale(-1 1)">${pava()}</g>
      <g transform="translate(85 44) scale(0.62)">${gladFlower()}</g>
      <circle cx="0" cy="100" r="4" class="pb"/><circle cx="170" cy="100" r="4" class="pb"/>
      <path d="M0 110H170" class="sb" stroke-width="2"/>`,
  },
  {
    w: 104, h: 128,
    body: `<path d="M52 128C52 96 30 92 30 64C30 40 52 40 52 12" class="sa" stroke-width="2.5"/>
      ${berry(52, 22)}${berry(34, 58)}${berry(64, 84)}
      ${leaf(72, 40, 50)}${leaf(34, 92, -50)}
      <g transform="translate(52 0)">${berry(0, 4)}</g><g transform="translate(52 128)">${berry(0, -10)}</g>`,
  },
];

const base = (article.order - 1) * 3;
const firstIdx = base % patterns.length;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{article.title} — Владимир-33</title>
    <meta name="description" content={article.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon/favicon-96x96.png" />
  </head>
  <body>
    <div class="stage" data-stage data-base={base} data-count={patterns.length}>
      <svg class="pattern" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
        <defs>
          {patterns.map((p, n) => (
            <pattern id={`folk${n}`} width={p.w} height={p.h} patternUnits="userSpaceOnUse" set:html={p.body} />
          ))}
        </defs>
        <g class="field" data-layer style="opacity:1"><rect x="-75%" y="-75%" width="250%" height="250%" fill={`url(#folk${firstIdx})`} /></g>
        <g class="field" data-layer style="opacity:0"><rect x="-75%" y="-75%" width="250%" height="250%" fill={`url(#folk${firstIdx})`} /></g>
      </svg>

      <article class="reader">
        <p class="reader__kicker">{article.title}</p>
        {article.slides.map((s, i) => (
          <p class="reader__caption" data-caption data-active={i === 0 ? 'true' : 'false'}>{s.caption}</p>
        ))}
        <div class="reader__dots">
          {article.slides.map((_, i) => (
            <button class="rdot" data-dot={i} data-active={i === 0 ? 'true' : 'false'} aria-label={`Слайд ${i + 1}`} />
          ))}
        </div>
        <p class="reader__hint" data-hint>
          <span class="reader__hint-arr">‹</span>
          листайте
          <span class="reader__hint-arr">›</span>
        </p>
      </article>

      <a class="stage__close" href="/#architecture" aria-label="Закрыть">×</a>
      <button class="stage__nav stage__nav--prev" data-prev aria-label="Назад">‹</button>
      <button class="stage__nav stage__nav--next" data-next aria-label="Вперёд">›</button>
    </div>

    <script>
      const PALETTE = [
        '#d98c94', '#e3a9ac', '#c97b84', '#b5677a', '#7fa3c4', '#a9c0d6',
        '#5b7ba3', '#6f8fae', '#7fae87', '#a8c8a0', '#5f8f6c', '#d9b46a',
        '#e6c98a', '#caa15f', '#b59ac4', '#9d8bb0',
      ];

      const stage = document.querySelector<HTMLElement>('[data-stage]');
      if (stage) {
        const base = Number(stage.dataset.base) || 0;
        const PCOUNT = Number(stage.dataset.count) || 1;
        const layers = Array.from(stage.querySelectorAll<SVGElement>('[data-layer]'));
        const captions = Array.from(stage.querySelectorAll<HTMLElement>('[data-caption]'));
        const dots = Array.from(stage.querySelectorAll<HTMLElement>('[data-dot]'));
        let i = 0;
        let activeLayer = 0;
        const lite = window.matchMedia('(max-width: 700px), (prefers-reduced-motion: reduce)').matches;

        const drift = (s: number) =>
          `translate(${Math.sin(s * 1.3) * 90}px, ${Math.cos(s * 0.9) * 70}px) rotate(${s * 7 - 10}deg) scale(${1 + (s % 3) * 0.07})`;

        const hint = stage.querySelector<HTMLElement>('[data-hint]');

        const apply = (n: number) => {
          hint?.setAttribute('data-gone', 'true');
          i = (n + captions.length) % captions.length;
          captions.forEach((c, k) => c.setAttribute('data-active', String(k === i)));
          dots.forEach((d, k) => d.setAttribute('data-active', String(k === i)));

          const patIdx = (base + i) % PCOUNT;
          const next = activeLayer ^ 1;
          const inc = layers[next];
          const out = layers[activeLayer];
          inc.querySelector('rect')!.setAttribute('fill', `url(#folk${patIdx})`);
          if (!lite) inc.style.transform = drift(i);
          requestAnimationFrame(() => {
            inc.style.opacity = '1';
            out.style.opacity = '0';
          });
          activeLayer = next;

          stage.style.setProperty('--pat-a', PALETTE[(base + i) % 16]);
          stage.style.setProperty('--pat-b', PALETTE[(base + i + 6) % 16]);
        };

        stage.querySelector('[data-prev]')!.addEventListener('click', () => apply(i - 1));
        stage.querySelector('[data-next]')!.addEventListener('click', () => apply(i + 1));
        dots.forEach((d, n) => d.addEventListener('click', () => apply(n)));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') apply(i - 1);
          else if (e.key === 'ArrowRight') apply(i + 1);
          else if (e.key === 'Escape') location.href = '/#architecture';
        });

        let startX: number | null = null;
        stage.addEventListener('touchstart', (e) => (startX = e.changedTouches[0].screenX), { passive: true });
        stage.addEventListener('touchend', (e) => {
          if (startX === null) return;
          const dx = e.changedTouches[0].screenX - startX;
          if (dx > 50) apply(i - 1);
          else if (dx < -50) apply(i + 1);
          startX = null;
        }, { passive: true });

        if (!lite) layers[0].style.transform = drift(0);
        stage.style.setProperty('--pat-a', PALETTE[base % 16]);
        stage.style.setProperty('--pat-b', PALETTE[(base + 6) % 16]);
      }
    </script>

    <style>
      @import '@fontsource/forum/cyrillic.css';
      @import '@fontsource/pt-serif/cyrillic.css';

      @property --pat-a { syntax: '<color>'; inherits: true; initial-value: #d98c94; }
      @property --pat-b { syntax: '<color>'; inherits: true; initial-value: #7fa3c4; }

      :root { --bg: #f6f0e3; --ink: #2b2117; }
      * { box-sizing: border-box; margin: 0; }
      body { background: var(--bg); overflow: hidden; }

      .stage {
        position: fixed; inset: 0; overflow: hidden;
        --pat-a: #d98c94; --pat-b: #7fa3c4;
        transition: --pat-a 1.2s ease, --pat-b 1.2s ease;
      }

      .pattern { position: absolute; inset: 0; width: 100%; height: 100%; }
      .field {
        opacity: 0;
        transform-box: view-box; transform-origin: center;
        transition: transform 1.3s cubic-bezier(0.45, 0.05, 0.2, 1), opacity 1.1s ease;
        will-change: opacity;
      }
      :global(.pa) { fill: var(--pat-a); }
      :global(.pb) { fill: var(--pat-b); }
      :global(.sa) { stroke: var(--pat-a); fill: none; }
      :global(.sb) { stroke: var(--pat-b); fill: none; }
      @media (prefers-reduced-motion: reduce) {
        .field, .stage { transition: opacity 0.3s ease; }
      }

      .reader {
        position: relative; z-index: 2;
        max-width: min(92vw, 720px); margin: 0 auto; height: 100%;
        display: flex; flex-direction: column; justify-content: center;
        gap: 1.3rem; padding: 2rem; text-align: center;
      }
      .reader::before {
        content: ''; position: absolute; inset: clamp(1rem, 8vh, 6rem) -3rem; z-index: -1;
        background: radial-gradient(ellipse at center, color-mix(in srgb, var(--bg) 94%, transparent) 46%, color-mix(in srgb, var(--bg) 70%, transparent) 68%, transparent 82%);
      }
      .reader__kicker { font-family: 'Forum', serif; font-size: clamp(1.9rem, 1rem + 3.6vw, 3.4rem); color: #8a3320; line-height: 1.05; }
      .reader__caption { display: none; font-family: 'PT Serif', Georgia, serif; font-size: clamp(1.05rem, 0.95rem + 0.7vw, 1.4rem); line-height: 1.65; color: var(--ink); }
      .reader__caption[data-active='true'] { display: block; animation: capIn 0.7s ease both; }
      @keyframes capIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

      .reader__dots { display: flex; gap: 0.55rem; justify-content: center; margin-top: 0.4rem; }
      .rdot { width: 26px; height: 4px; border: none; border-radius: 999px; background: color-mix(in srgb, var(--ink) 25%, transparent); cursor: pointer; padding: 0; transition: background 0.3s, width 0.3s; }
      .rdot[data-active='true'] { background: #8a3320; width: 40px; }

      .reader__hint {
        display: flex; align-items: center; justify-content: center; gap: 0.5rem;
        margin-top: 0.7rem; font-family: 'PT Serif', Georgia, serif; font-style: italic;
        font-size: 0.92rem; letter-spacing: 0.02em;
        color: color-mix(in srgb, var(--ink) 52%, transparent);
        opacity: 0; animation: hintIn 0.9s ease 0.8s both;
        transition: opacity 0.5s ease, transform 0.5s ease;
        pointer-events: none;
      }
      .reader__hint[data-gone='true'] { opacity: 0; transform: translateY(6px); }
      .reader__hint-arr {
        font-family: 'Forum', serif; font-size: 1.25rem; line-height: 1; color: #8a3320;
        animation: hintNudge 1.9s ease-in-out infinite;
      }
      .reader__hint-arr:last-child { animation-delay: 0.95s; }
      @keyframes hintIn { from { opacity: 0; } to { opacity: 1; } }
      @keyframes hintNudge {
        0%, 100% { transform: translateX(0); }
        50% { transform: translateX(3px); }
      }
      .reader__hint-arr:first-child { animation-name: hintNudgeL; }
      @keyframes hintNudgeL {
        0%, 100% { transform: translateX(0); }
        50% { transform: translateX(-3px); }
      }
      @media (prefers-reduced-motion: reduce) {
        .reader__hint-arr { animation: none; }
      }

      .stage__close, .stage__nav {
        position: fixed; z-index: 5; display: grid; place-items: center;
        background: color-mix(in srgb, var(--bg) 78%, transparent);
        border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
        color: var(--ink); border-radius: 50%; cursor: pointer; text-decoration: none;
        backdrop-filter: blur(3px); transition: background 0.2s, transform 0.2s;
      }
      .stage__close:hover, .stage__nav:hover { background: var(--bg); }
      .stage__close { top: 1.2rem; right: 1.2rem; width: 46px; height: 46px; font-size: 1.7rem; line-height: 1; }
      .stage__nav { top: 50%; translate: 0 -50%; width: 54px; height: 54px; font-size: 2rem; }
      .stage__nav--prev { left: 1.2rem; }
      .stage__nav--next { right: 1.2rem; }

      @media (max-width: 560px) {
        .stage__nav { top: auto; bottom: 1.3rem; translate: none; width: 48px; height: 48px; font-size: 1.8rem; }
      }
    </style>
  </body>
</html>
